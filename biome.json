{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!drizzle/meta", "!modules/developer-manual/client/App-routes-snippet.tsx"]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": {
    "enabled": true,
    "domains": { "drizzle": "all" },
    "rules": {
      "preset": "recommended",
      "suspicious": { "noUnknownAtRules": "off" },
      "nursery": {
        "noDrizzleDeleteWithoutWhere": {
          "level": "error",
          "options": { "drizzleObjectName": ["db", "tx", "trx", "database"] }
        },
        "noDrizzleUpdateWithoutWhere": {
          "level": "error",
          "options": { "drizzleObjectName": ["db", "tx", "trx", "database"] }
        }
      }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
